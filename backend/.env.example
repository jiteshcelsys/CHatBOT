APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:3000

# Supabase
# Use new API keys from: Project Settings → API (legacy anon/service_role keys were disabled 2026-05-22)
SUPABASE_URL=
SUPABASE_ANON_KEY=          # new "publishable" key
SUPABASE_SERVICE_ROLE_KEY=  # new "secret" key

# Firebase
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=

# Groq (LLM — chat/generation)
# Get your free key at: https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# HuggingFace embeddings (runs locally — no key needed)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# LangSmith tracing (optional)
LANGCHAIN_API_KEY=
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=chatbot

# ChromaDB
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_CHUNK_SIZE=1000
CHROMA_CHUNK_OVERLAP=200

# Ingestion pipeline
INGESTION_ALLOWED_TYPES=[".pdf",".txt",".docx",".md"]
INGESTION_MAX_FILE_SIZE_MB=50
INGESTION_MAX_BATCH_FILES=10

# Chat
CHAT_MAX_SESSIONS_PER_USER=20
CHAT_SUMMARY_THRESHOLD=20
